{% extends 'base.html.twig' %}
{% set page_id = 'blog' %}
{% set route_name = 'app_blog' %}
{% set body_class = 'inner-page' %}
{% set og_image = asset('images/ultra-ice-tea-luffy.jpg') %}

{% block body %}
<main id="main"><section class="page-hero blog-hero"><div class="page-hero-media"><img src="{{ asset('images/ULTRAPOP-sale.jpg') }}" alt="{{ 'Snacks pop culture ULTRAPOP'|trans }}" width="1201" height="801"></div><div class="shell"><div class="breadcrumb"><a href="{{ path('app_home.' ~ app.request.locale) }}">{{ 'Accueil'|trans }}</a> {{ '/ Le Mag'|trans }}</div><p class="eyebrow light"><span></span> {{ 'Tendances · Distribution · Pop culture'|trans }}</p><h1>{{ 'Ce qui fera'|trans }}<br>{{ 'vendre'|trans }} <em>{{ 'demain.'|trans }}</em></h1><p>{{ 'Des idées concrètes pour comprendre les nouvelles attentes, construire votre assortiment et faire vivre vos rayons.'|trans }}</p></div></section>
    <section class="blog-list"><div class="shell"><div class="article-grid"><a class="article-card featured reveal" href="{{ path('app_article_trends.' ~ app.request.locale) }}"><div class="article-image"><img src="{{ asset('images/ultra-ice-tea-luffy.jpg') }}" alt="Ultra Ice Tea One Piece" width="1083" height="1083"><span>{{ 'Décryptage'|trans }}</span></div><div class="article-copy"><small>{{ '6 min · Tendances'|trans }}</small><h3>{{ 'Pourquoi la pop culture transforme le rayon snacking'|trans }}</h3><span class="arrow">↗</span></div></a><a class="article-card reveal" href="{{ path('app_article_wholesaler.' ~ app.request.locale) }}"><div class="article-image"><img src="{{ asset('images/ultra-ice-tea-naruto.jpg') }}" alt="Ultra Ice Tea Naruto" width="1083" height="1083"><span>{{ 'Conseils'|trans }}</span></div><div class="article-copy"><small>{{ '5 min · Distribution'|trans }}</small><h3>{{ 'Comment choisir son grossiste en boissons manga ?'|trans }}</h3><span class="arrow">↗</span></div></a><a class="article-card reveal" href="{{ path('app_article_merchandising.' ~ app.request.locale) }}"><div class="article-image"><img src="{{ asset('images/ULTRAPOP-sale.jpg') }}" alt="{{ 'Assortiment de snacks sous licence'|trans }}" width="1201" height="801"><span>{{ 'Retail'|trans }}</span></div><div class="article-copy"><small>{{ '7 min · Merchandising'|trans }}</small><h3>{{ '5 leviers pour rendre vos produits sous licence irrésistibles'|trans }}</h3><span class="arrow">↗</span></div></a></div></div></section>
    <section class="inline-cta"><div class="shell"><h2>{{ 'Une question sur votre assortiment ?'|trans }}</h2><button class="button" type="button" data-open-contact>{{ 'Parler à notre équipe'|trans }} <span>↗</span></button></div></section></main>
{% endblock %}
