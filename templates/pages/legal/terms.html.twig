{% extends 'base.html.twig' %}
{% set page_id = 'terms' %}
{% set route_name = 'app_terms' %}
{% set body_class = 'inner-page' %}

{% block body %}
<main id="main">
  <header class="page-hero legal-hero">
    <div class="shell">
      <div class="breadcrumb"><a href="{{ path('app_home.' ~ app.request.locale) }}">{{ 'Accueil'|trans }}</a> / {{ 'Conditions générales'|trans }}</div>
      <p class="eyebrow light"><span></span> LNS Trade</p>
      <h1>{{ 'Conditions générales'|trans }}</h1>
    </div>
  </header>
  <article class="legal-document shell">

      <p class="legal-updated">{{ 'content.terms.1'|trans }}</p>
      <p class="legal-lead">{{ 'content.terms.2'|trans }}</p>

      <h2>{{ 'content.terms.3'|trans }}</h2>
      <ul>
        <li>{{ 'content.terms.4'|trans }}</li>
        <li>{{ 'content.terms.5'|trans }}</li>
        <li>{{ 'content.terms.6'|trans }}</li>
      </ul>

      <h2>{{ 'content.terms.7'|trans }}</h2>
      <p>{{ 'content.terms.8'|trans }}</p>

      <h2>{{ 'content.terms.9'|trans }}</h2>
      <p>{{ 'content.terms.10'|trans }}</p>

      <h2>{{ 'content.terms.11'|trans }}</h2>
      <p>{{ 'content.terms.12'|trans }}</p>

      <h2>{{ 'content.terms.13'|trans }}</h2>
      <p>{{ 'content.terms.14'|trans }}</p>

      <h2>{{ 'content.terms.15'|trans }}</h2>
      <p>{{ 'content.terms.16'|trans }} <a href="mailto:info@lnstrade.fr">{{ 'content.terms.17'|trans }}</a>.</p>

  </article>
</main>
{% endblock %}
