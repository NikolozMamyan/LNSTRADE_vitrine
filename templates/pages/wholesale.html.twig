{% extends 'base.html.twig' %}
{% set page_id = 'wholesale' %}
{% set route_name = 'app_wholesale' %}
{% set body_class = 'inner-page wholesale-page' %}
{% set faq_items = [
  {question: 'Quels produits manga sont disponibles ?', answer: 'seo.faq.wholesale.products'},
  {question: 'Livrez-vous les commerces indépendants ?', answer: 'seo.faq.wholesale.customers'},
  {question: 'Vos produits sont-ils sous licences officielles ?', answer: 'seo.faq.wholesale.licences'},
  {question: 'Comment obtenir les tarifs professionnels ?', answer: 'seo.faq.wholesale.pricing'},
  {question: 'seo.faq.logistics.question', answer: 'seo.faq.logistics.answer'}
] %}
{% set og_image = asset('images/ULTRAPOP-sale.webp') %}

{% block body %}
<main id="main">
    <section class="page-hero wholesale-hero">
      <div class="page-hero-media"><img src="{{ asset('images/ULTRAPOP-boissons.webp') }}" alt="{{ 'Boissons manga ULTRAPOP One Piece, Naruto et Dragon Ball'|trans }}" fetchpriority="high" width="1600" height="640" srcset="{{ asset('images/ULTRAPOP-boissons-640.webp') }} 640w, {{ asset('images/ULTRAPOP-boissons.webp') }} 1600w" sizes="100vw"></div>
      <div class="shell wholesale-hero-grid">
        <div class="wholesale-hero-copy">
          <div class="breadcrumb"><a href="{{ path('app_home.' ~ app.request.locale) }}">{{ 'Accueil'|trans }}</a> / {{ 'Grossiste manga'|trans }}</div>
          <p class="eyebrow light"><span></span> {{ 'Offre B2B · Licences officielles'|trans }}</p>
          <h1>{{ 'Grossiste'|trans }} <br>{{ 'snacks & boissons'|trans }} <br><em>{{ 'pour professionnels.'|trans }}</em></h1>
          <p>{{ 'Boissons, snacks et confiseries manga sous licences officielles pour commerces, distributeurs et e-shops. Recevez les tarifs et les conditions adaptés à votre activité.'|trans }}</p>
          <button class="button button-primary" type="button" data-open-contact>{{ 'Recevoir nos tarifs professionnels'|trans }} <span aria-hidden="true">↗</span></button>
        </div>
        {% include 'partials/_contact_form.html.twig' with {form_class: 'wholesale-lead-form', contact_context: 'Tarifs professionnels', contact_label: 'Recevoir nos tarifs professionnels', submit_label: 'Recevoir nos tarifs professionnels'} %}
      </div>
    </section>
    <section class="content-section"><div class="shell content-grid reveal"><div><div class="section-index">{{ 'UNE OFFRE QUI SE REMARQUE'|trans }}</div><h2>{{ 'La culture fan'|trans }} <br><em>{{ 'rencontre le food.'|trans }}</em></h2></div><div class="prose"><p>{{ 'Avec ULTRAPOP, LNS Trade propose aux professionnels une gamme de boissons et produits de snacking inspirée des univers manga, anime et gaming les plus populaires.'|trans }}</p><p>{{ 'Chaque référence associe une recette accessible, un packaging à fort impact et une licence officielle. Le résultat : des produits immédiatement identifiables, capables de créer l’achat d’impulsion tout en nourrissant la collection.'|trans }}</p><h3>{{ 'Boissons manga'|trans }}</h3><p>{{ 'Canettes, bouteilles et bubble teas mettent en scène des héros connus sur des formats adaptés à la vente à emporter, au rayon frais ou à l’épicerie.'|trans }}</p><h3>{{ 'Snacks salés et instant food'|trans }}</h3><p>{{ 'Chips de riz, chips de pomme de terre et nouilles instantanées offrent des usages variés, de l’apéritif au repas rapide.'|trans }}</p><h3>{{ 'Confiseries sous licence'|trans }}</h3><p>{{ 'Des formats colorés et faciles à exposer pour compléter un corner pop culture ou enrichir une sélection de produits d’impulsion.'|trans }}</p></div></div>
      <div class="shell seo-cards"><article class="seo-card reveal"><span>01</span><h3>{{ 'Impact visuel'|trans }}</h3><p>{{ 'Des packagings conçus pour être vus vite et reconnus immédiatement.'|trans }}</p></article><article class="seo-card reveal"><span>02</span><h3>{{ 'Gamme cohérente'|trans }}</h3><p>{{ 'Plusieurs catégories pour composer un assortiment complet et rythmer vos lancements.'|trans }}</p></article><article class="seo-card reveal"><span>03</span><h3>{{ 'Support B2B'|trans }}</h3><p>{{ 'Conseil assortiment, disponibilité, logistique et accompagnement commercial.'|trans }}</p></article></div>
    </section>
    <section class="content-section" style="background:#ff5535;color:#fff"><div class="shell content-grid reveal"><div><div class="section-index light">ULTRAPOP</div><h2>{{ 'Des licences'|trans }} <br>{{ 'qui parlent à'|trans }} <br><em>{{ 'vos clients.'|trans }}</em></h2></div><div class="prose" style="color:rgba(255,255,255,.76)"><p style="color:#fff">{{ 'One Piece, Naruto Shippuden, Dragon Ball, Demon Slayer ou League of Legends : ULTRAPOP transforme des univers à forte communauté en produits food à part entière.'|trans }}</p><p>{{ 'Notre approche ne consiste pas à poser un personnage sur un emballage. Chaque concept est travaillé pour rester cohérent avec l’univers de la licence, la catégorie produit et les attentes des points de vente.'|trans }}</p><h3 style="color:#fff">{{ 'À qui s’adresse notre offre ?'|trans }}</h3><ul><li>{{ 'Grossistes et distributeurs alimentaires'|trans }}</li><li>{{ 'Grandes et moyennes surfaces'|trans }}</li><li>{{ 'Concept stores, épiceries et commerces spécialisés'|trans }}</li><li>{{ 'Sites e-commerce et marketplaces'|trans }}</li><li>{{ 'Hôtels, restaurants, cafés et lieux de loisirs'|trans }}</li></ul><button class="button button-light" type="button" data-open-contact data-interest="{{ 'Tarifs professionnels'|trans }}">{{ 'Recevoir nos tarifs professionnels'|trans }} <span>↗</span></button></div></div></section>
    <section class="content-section shell faq"><div class="faq-title"><div class="section-index">{{ 'FAQ B2B'|trans }}</div><h2>{{ 'Vos questions,'|trans }} <br><em>{{ 'nos réponses.'|trans }}</em></h2></div><div class="faq-list">{% include 'partials/_faq_list.html.twig' %}</div></section>
    {% include 'pages/_wholesale_advice.html.twig' %}
    {% include 'partials/_trade_conditions.html.twig' %}
    <section class="inline-cta"><div class="shell"><h2>{{ 'Prêt à créer un rayon qui arrête vraiment le regard ?'|trans }}</h2><button class="button" type="button" data-open-contact data-interest="{{ 'Tarifs professionnels'|trans }}">{{ 'Recevoir nos tarifs professionnels'|trans }} <span>↗</span></button></div></section>
  </main>
{% endblock %}
