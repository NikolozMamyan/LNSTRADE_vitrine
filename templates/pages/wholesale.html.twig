{% extends 'base.html.twig' %}
{% set page_id = 'wholesale' %}
{% set route_name = 'app_wholesale' %}
{% set body_class = 'inner-page' %}
{% set og_image = asset('images/ULTRAPOP-sale.jpg') %}

{% block body %}
<main id="main">
    <section class="page-hero"><div class="page-hero-media"><img src="{{ asset('images/ULTRAPOP-boissons.jpg') }}" alt="{{ 'Boissons manga ULTRAPOP One Piece, Naruto et Dragon Ball'|trans }}" width="2000" height="800"></div><div class="shell"><div class="breadcrumb"><a href="{{ path('app_home.' ~ app.request.locale) }}">{{ 'Accueil'|trans }}</a> {{ '/ Grossiste manga'|trans }}</div><p class="eyebrow light"><span></span> {{ 'Offre B2B · Licences officielles'|trans }}</p><h1>{{ 'Grossiste'|trans }}<br>{{ 'snacks & boissons'|trans }}<br><em>manga.</em></h1><p>{{ 'Des références pop culture désirables, prêtes à dynamiser les rayons des distributeurs, enseignes, commerces et e-shops.'|trans }}</p></div></section>
    <section class="content-section"><div class="shell content-grid reveal"><div><div class="section-index">{{ 'UNE OFFRE QUI SE REMARQUE'|trans }}</div><h2>{{ 'La culture fan'|trans }}<br><em>{{ 'rencontre le food.'|trans }}</em></h2></div><div class="prose"><p>{{ 'Avec ULTRAPOP, LNS Trade propose aux professionnels une gamme de boissons et produits de snacking inspirée des univers manga, anime et gaming les plus populaires.'|trans }}</p><p>{{ 'Chaque référence associe une recette accessible, un packaging à fort impact et une licence officielle. Le résultat : des produits immédiatement identifiables, capables de créer l’achat d’impulsion tout en nourrissant la collection.'|trans }}</p><h3>{{ 'Boissons manga'|trans }}</h3><p>{{ 'Canettes, bouteilles et bubble teas mettent en scène des héros connus sur des formats adaptés à la vente à emporter, au rayon frais ou à l’épicerie.'|trans }}</p><h3>{{ 'Snacks salés et instant food'|trans }}</h3><p>{{ 'Chips de riz, chips de pomme de terre et nouilles instantanées offrent des usages variés, de l’apéritif au repas rapide.'|trans }}</p><h3>{{ 'Confiseries sous licence'|trans }}</h3><p>{{ 'Des formats colorés et faciles à exposer pour compléter un corner pop culture ou enrichir une sélection de produits d’impulsion.'|trans }}</p></div></div>
      <div class="shell seo-cards"><article class="seo-card reveal"><span>01</span><h3>{{ 'Impact visuel'|trans }}</h3><p>{{ 'Des packagings conçus pour être vus vite et reconnus immédiatement.'|trans }}</p></article><article class="seo-card reveal"><span>02</span><h3>{{ 'Gamme cohérente'|trans }}</h3><p>{{ 'Plusieurs catégories pour composer un assortiment complet et rythmer vos lancements.'|trans }}</p></article><article class="seo-card reveal"><span>03</span><h3>{{ 'Support B2B'|trans }}</h3><p>{{ 'Conseil assortiment, disponibilité, logistique et accompagnement commercial.'|trans }}</p></article></div>
    </section>
    <section class="content-section" style="background:#ff5535;color:#fff"><div class="shell content-grid reveal"><div><div class="section-index light">ULTRAPOP</div><h2>{{ 'Des licences'|trans }}<br>{{ 'qui parlent à'|trans }}<br><em>{{ 'vos clients.'|trans }}</em></h2></div><div class="prose" style="color:rgba(255,255,255,.76)"><p style="color:#fff">{{ 'One Piece, Naruto Shippuden, Dragon Ball, Demon Slayer ou League of Legends : ULTRAPOP transforme des univers à forte communauté en produits food à part entière.'|trans }}</p><p>{{ 'Notre approche ne consiste pas à poser un personnage sur un emballage. Chaque concept est travaillé pour rester cohérent avec l’univers de la licence, la catégorie produit et les attentes des points de vente.'|trans }}</p><h3 style="color:#fff">{{ 'À qui s’adresse notre offre ?'|trans }}</h3><ul><li>{{ 'Grossistes et distributeurs alimentaires'|trans }}</li><li>{{ 'Grandes et moyennes surfaces'|trans }}</li><li>{{ 'Concept stores, épiceries et commerces spécialisés'|trans }}</li><li>{{ 'Sites e-commerce et marketplaces'|trans }}</li><li>{{ 'Hôtels, restaurants, cafés et lieux de loisirs'|trans }}</li></ul><button class="button button-light" type="button" data-open-contact data-interest="Catalogue ULTRAPOP">{{ 'Recevoir le catalogue'|trans }} <span>↗</span></button></div></div></section>
    <section class="content-section shell faq"><div class="faq-title"><div class="section-index">{{ 'FAQ B2B'|trans }}</div><h2>{{ 'Vos questions,'|trans }}<br><em>{{ 'nos réponses.'|trans }}</em></h2></div><div class="faq-list"><details><summary>{{ 'Quels produits manga sont disponibles ?'|trans }}<span>+</span></summary><p>{{ 'La gamme comprend des boissons, bubble teas, snacks salés, confiseries et nouilles instantanées. La disponibilité varie selon les collections et les marchés.'|trans }}</p></details><details><summary>{{ 'Livrez-vous les commerces indépendants ?'|trans }}<span>+</span></summary><p>{{ 'Oui. Nous travaillons avec des structures de tailles et de canaux différents. Contactez-nous pour vérifier l’adéquation de l’offre avec votre projet.'|trans }}</p></details><details><summary>{{ 'Vos produits sont-ils sous licences officielles ?'|trans }}<span>+</span></summary><p>{{ 'Oui. Les produits ULTRAPOP présentés avec un univers manga ou gaming sont développés dans le cadre de licences officielles.'|trans }}</p></details><details><summary>{{ 'Comment obtenir les tarifs professionnels ?'|trans }}<span>+</span></summary><p>{{ 'Indiquez votre société, votre canal et votre pays via le formulaire. L’équipe commerciale vous communiquera les conditions adaptées.'|trans }}</p></details></div></section>
    <section class="inline-cta"><div class="shell"><h2>{{ 'Prêt à créer un rayon qui arrête vraiment le regard ?'|trans }}</h2><button class="button" type="button" data-open-contact data-interest="Catalogue ULTRAPOP">{{ 'Recevoir le catalogue'|trans }} <span>↗</span></button></div></section>
  </main>
{% endblock %}
