{% set page_id = page_id|default('home') %}
{% set route_name = route_name|default('app_home') %}
{% set body_class = body_class|default('') %}
{% set is_article = is_article|default(false) %}
{% set skeleton_variant = page_id == 'licence' ? 'wholesale' : (page_id in ['choosingWholesaler', 'merchandising', 'snackingTrends', 'terms', 'privacy', 'legal', 'contact', 'products'] ? 'article' : page_id) %}
{% set site_origin = site_url|trim('/') %}
{% set canonical_url = site_origin ~ path(route_name ~ '.' ~ app.request.locale, route_params|default({})) %}
{% set english_url = site_origin ~ path(route_name ~ '.en', route_params|default({})) %}
{% set french_url = site_origin ~ path(route_name ~ '.fr', route_params|default({})) %}
{% set page_title = page_title|default(('meta.' ~ page_id ~ '.title')|trans) %}
{% set page_description = page_description|default(('meta.' ~ page_id ~ '.description')|trans) %}
{% set social_image = site_origin ~ (og_image|default(asset('images/ULTRAPOP-collection.webp'))) %}
{% set organization_id = site_origin ~ '/#organization' %}
{% set website_id = site_origin ~ '/#website' %}
<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-WX33M7V8');</script>
  <!-- End Google Tag Manager -->
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-55X3CXZ5B7"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-55X3CXZ5B7');
  </script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>document.documentElement.classList.add('js', 'skeleton-active')</script>
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_description }}">
  <meta name="theme-color" content="#11110f">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <link rel="canonical" href="{{ canonical_url }}">
  {% for locale in site_locales %}<link rel="alternate" hreflang="{{ locale }}" href="{{ site_origin ~ path(route_name ~ '.' ~ locale, route_params|default({})) }}">{% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ page_id == 'home' ? site_origin ~ path('app_locale') : english_url }}">
  <link rel="icon" href="{{ asset('favicon.ico') }}" type="image/x-icon" sizes="any">

  <meta property="og:type" content="{{ is_article ? 'article' : 'website' }}">
  <meta property="og:site_name" content="LNS Trade">
  {% set social_locales = {en: 'en_GB', fr: 'fr_FR', de: 'de_DE', es: 'es_ES', nb: 'nb_NO', nl: 'nl_NL'} %}
  <meta property="og:locale" content="{{ social_locales[app.request.locale] }}">
  {% for locale in site_locales %}{% if locale != app.request.locale %}<meta property="og:locale:alternate" content="{{ social_locales[locale] }}">{% endif %}{% endfor %}
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_description }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="{{ social_image }}">
  <meta property="og:image:alt" content="{{ og_image_alt|default('seo.social_image_alt'|trans) }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ page_description }}">
  <meta name="twitter:image" content="{{ social_image }}">
  <meta name="twitter:image:alt" content="{{ og_image_alt|default('seo.social_image_alt'|trans) }}">
  {% if is_article %}<meta property="article:published_time" content="{{ article_date }}T09:00:00+02:00">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;0,900;1,800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  {{ turbo_refreshes_with(method: 'morph', scroll: 'preserve') }}
  {{ importmap('app') }}

  {% set page_schema = {
    '@type': is_article ? 'BlogPosting' : page_schema_type|default('WebPage'),
    '@id': canonical_url ~ '#page',
    'url': canonical_url,
    'name': page_title,
    'headline': page_title,
    'description': page_description,
    'inLanguage': app.request.locale,
    'image': social_image,
    'mainEntityOfPage': canonical_url,
    'isPartOf': {'@id': website_id},
    'publisher': {'@id': organization_id}
  } %}
  {% if page_schema_extra is defined %}{% set page_schema = page_schema|merge(page_schema_extra) %}{% endif %}
  {% if is_article %}
    {% set page_schema = page_schema|merge({
      'author': {'@type': 'Organization', '@id': organization_id, 'name': 'LNS Trade', 'url': site_origin ~ path('app_home.' ~ app.request.locale)},
      'datePublished': article_date,
      'dateModified': article_modified|default(article_date)
    }) %}
    <meta property="article:modified_time" content="{{ article_modified|default(article_date) }}T09:00:00+02:00">
  {% endif %}
  {% set organization_schema = {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': organization_id,
        'name': 'LNS Trade',
        'alternateName': ['LNSTRADE', 'ULTRAPOP by LNS Trade'],
        'url': site_origin ~ '/',
        'logo': site_origin ~ asset('images/logo-lns-white.webp'),
        'description': 'seo.organization_description'|trans,
        'foundingDate': '2014',
        'address': {
          '@type': 'PostalAddress',
          'streetAddress': '13 Quai Kléber',
          'postalCode': '67000',
          'addressLocality': 'Strasbourg',
          'addressCountry': 'FR'
        },
        'contactPoint': {
          '@type': 'ContactPoint',
          'contactType': 'sales',
          'email': 'info@lnstrade.fr',
          'telephone': '+33388840380',
          'availableLanguage': ['fr', 'en']
        },
        'brand': {'@type': 'Brand', '@id': site_origin ~ path('app_ultrapop.en') ~ '#brand', 'name': 'ULTRAPOP'},
        'hasOfferCatalog': {'@type': 'OfferCatalog', 'name': 'seo.catalog_name'|trans, 'url': site_origin ~ path('app_products.' ~ app.request.locale)},
        'sameAs': ['https://www.instagram.com/ULTRAPOP_/', 'https://www.tiktok.com/@ULTRAPOP_', 'https://fr.linkedin.com/company/ULTRAPOPbylnstrade']
      },
      {
        '@type': 'WebSite',
        '@id': website_id,
        'url': site_origin ~ '/',
        'name': 'seo.site_name'|trans,
        'inLanguage': app.request.locale,
        'publisher': {'@id': organization_id}
      },
      page_schema
    ]
  } %}
  {% if page_id != 'home' %}
    {% set breadcrumb_items = [{'@type': 'ListItem', 'position': 1, 'name': 'Accueil'|trans, 'item': site_origin ~ path('app_home.' ~ app.request.locale)}] %}
    {% if is_article %}
      {% set breadcrumb_items = breadcrumb_items|merge([{'@type': 'ListItem', 'position': 2, 'name': 'Le Mag'|trans, 'item': site_origin ~ path('app_blog.' ~ app.request.locale)}]) %}
    {% endif %}
    {% if page_id == 'licence' %}
      {% set breadcrumb_items = breadcrumb_items|merge([{'@type': 'ListItem', 'position': 2, 'name': 'ULTRAPOP', 'item': site_origin ~ path('app_ultrapop.' ~ app.request.locale)}]) %}
    {% endif %}
    {% set breadcrumb_items = breadcrumb_items|merge([{'@type': 'ListItem', 'position': breadcrumb_items|length + 1, 'name': breadcrumb_title|default(page_title), 'item': canonical_url}]) %}
    {% set organization_schema = organization_schema|merge({'@graph': organization_schema['@graph']|merge([{'@type': 'BreadcrumbList', '@id': canonical_url ~ '#breadcrumb', 'itemListElement': breadcrumb_items}])}) %}
  {% endif %}
  {% if faq_items|default([]) is not empty %}
    {% set questions = [] %}
    {% for faq in faq_items %}
      {% set questions = questions|merge([{'@type': 'Question', 'name': faq.question|trans, 'acceptedAnswer': {'@type': 'Answer', 'text': faq.answer|trans}}]) %}
    {% endfor %}
    {% set organization_schema = organization_schema|merge({'@graph': organization_schema['@graph']|merge([{'@type': 'FAQPage', '@id': canonical_url ~ '#faq', 'mainEntity': questions}])}) %}
  {% endif %}
  <script type="application/ld+json" data-page-schema>{{ organization_schema|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
</head>
<body class="{{ body_class }}" data-route="{{ page_id }}" data-catalog-url="{{ path('app_catalog') }}">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WX33M7V8"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  {% include 'partials/_page_skeleton.html.twig' with {skeleton_variant: skeleton_variant} only %}
  <a class="skip-link" href="#main">{{ 'Aller au contenu'|trans }}</a>
  {% include 'partials/_header.html.twig' %}
  {% block body %}{% endblock %}
  {% include 'partials/_footer.html.twig' %}
  {% if page_id in ['home', 'blog', 'choosingWholesaler', 'merchandising', 'snackingTrends'] %}{% include 'partials/_newsletter.html.twig' %}{% endif %}
  {% if page_id not in ['wholesale', 'contact', 'licence'] %}{% include 'partials/_contact_modal.html.twig' %}{% endif %}
  {% include 'partials/_range_builder_modal.html.twig' %}
  <script id="lns-ui-copy" type="application/json">{{ {
    locale: app.request.locale,
    newsletter: {
      sending: 'newsletter.sending'|trans,
      error: 'newsletter.error'|trans,
      invalid: 'newsletter.invalid'|trans,
      rateLimit: 'newsletter.rate_limit'|trans
    },
    contact: {
      sending: 'form.contact.sending'|trans,
      success: 'form.contact.success'|trans,
      error: 'form.contact.error'|trans,
      invalid: 'form.contact.invalid'|trans
    }
  }|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
</body>
</html>
