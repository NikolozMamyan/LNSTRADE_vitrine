{% extends 'admin/base.html.twig' %}

{% block title %}Catalogue ULTRAPOP{% endblock %}
{% block page_name %}Catalogue ULTRAPOP{% endblock %}

{% block body %}
<div data-controller="catalog-admin" data-catalog-admin-worker-url-value="{{ asset('vendor/pdfjs-dist/build/pdf.worker.min.mjs.js') }}" data-action="submit->catalog-admin#submit" data-turbo="false">
  <div class="admin-flash admin-catalog-feedback" data-catalog-admin-target="feedback" role="status" aria-live="polite" hidden></div>
  <header class="admin-catalog-heading">
    <div>
      <p class="admin-eyebrow"><span></span> Module commercial</p>
      <h1>Catalogue <em>ULTRAPOP</em></h1>
      <p>Importez votre PDF, organisez les pages et publiez le catalogue quand il est prêt.</p>
    </div>
    <a class="admin-button admin-button-light" href="{{ path('admin_catalog_preview') }}" target="_blank" rel="noopener">Aperçu <span>↗</span></a>
  </header>

  <section class="admin-panel admin-catalog-settings">
    <form action="{{ path('admin_catalog_settings') }}" method="post" data-catalog-operation="settings">
      <input type="hidden" name="_token" value="{{ csrf_token('catalog_settings') }}">
      <div class="admin-catalog-status" data-catalog-admin-target="publishedStatus"><i class="{{ catalog.enabled ? 'is-online' : '' }}"></i><span><strong>{{ catalog.enabled ? 'Catalogue publié' : 'Catalogue désactivé' }}</strong><small>{{ catalog.enabled ? 'Le lecteur public est accessible.' : 'Le catalogue reste masqué tant qu’il n’est pas prêt.' }}</small></span></div>
      <label class="admin-catalog-field"><span>Titre du catalogue</span><input type="text" name="title" maxlength="180" required value="{{ catalog.title }}"></label>
      <label class="admin-catalog-toggle"><input type="checkbox" name="enabled" value="1"{% if catalog.enabled %} checked{% endif %}><span><strong>Publier le catalogue</strong><small>Active le lecteur public</small></span><i><b></b></i></label>
      <button class="admin-button admin-button-primary" type="submit">Enregistrer <span>✓</span></button>
    </form>
  </section>

  <div class="admin-catalog-import-grid">
    <section class="admin-panel admin-catalog-import">
      <header><span class="admin-catalog-import-icon">PDF</span><div><p class="admin-eyebrow"><span></span> Import principal</p><h2>Importer un PDF</h2><p>Un PDF multipage crée automatiquement une page par feuille.</p></div></header>
      <form action="{{ path('admin_catalog_import_pdf') }}" method="post" enctype="multipart/form-data" data-catalog-operation="pdf">
        <input type="hidden" name="_token" value="{{ csrf_token('catalog_import_pdf') }}">
        <input type="hidden" name="pdfPageCount" data-catalog-admin-target="pdfPageCount">
        <label class="admin-catalog-field"><span>Nom du document <small>optionnel</small></span><input type="text" name="pdfTitle" maxlength="150" placeholder="Catalogue ULTRAPOP 2026"></label>
        <label class="admin-catalog-file"><input type="file" name="pdf" accept=".pdf,application/pdf" required data-catalog-admin-target="pdfInput" data-action="change->catalog-admin#inspectPdf"><span>PDF</span><strong>Choisir un PDF</strong><small>90 Mo maximum · 200 pages</small></label>
        <p class="admin-catalog-file-status" data-catalog-admin-target="pdfStatus">Le nombre de pages sera détecté avant l’import.</p>
        <div class="admin-catalog-upload-previews" data-upload-previews hidden></div>
        <button class="admin-button admin-button-primary" type="submit" data-catalog-admin-target="pdfSubmit">Importer le PDF <span>↗</span></button>
      </form>
    </section>

    <section class="admin-panel admin-catalog-import">
      <header><span class="admin-catalog-import-icon admin-catalog-import-icon-image">IMG</span><div><p class="admin-eyebrow"><span></span> Pages visuelles</p><h2>Ajouter des images</h2><p>Ajoutez plusieurs pages JPG, PNG ou WebP en une seule fois.</p></div></header>
      <form action="{{ path('admin_catalog_add_images') }}" method="post" enctype="multipart/form-data" data-catalog-operation="images">
        <input type="hidden" name="_token" value="{{ csrf_token('catalog_add_images') }}">
        <label class="admin-catalog-file"><input type="file" name="images[]" accept="image/jpeg,image/png,image/webp" multiple required data-action="change->catalog-admin#previewImages"><span>IMG</span><strong>Choisir des images</strong><small>15 Mo maximum par image · 50 images</small></label>
        <p class="admin-catalog-file-status">Les images sont optimisées en WebP haute définition.</p>
        <div class="admin-catalog-upload-previews" data-upload-previews hidden></div>
        <button class="admin-button admin-button-primary" type="submit">Ajouter les pages <span>↗</span></button>
      </form>
    </section>
  </div>

  <section class="admin-catalog-pages" id="pages">
    <header><div><p class="admin-eyebrow"><span></span> Composition</p><h2 data-catalog-admin-target="pagesCount">{{ catalogPages|length }} page{{ catalogPages|length > 1 ? 's' : '' }}</h2><p>Modifiez le titre, le média, la visibilité et le lien de chaque page.</p></div><span data-catalog-admin-target="updatedAt">Mis à jour le {{ catalog.updatedAt|date('d/m/Y à H:i') }}</span></header>
    <div class="admin-catalog-page-grid" data-catalog-admin-target="pageGrid">
      {% for catalogPage in catalogPages %}
        {% include 'admin/catalog/_page.html.twig' %}
      {% else %}
        <div class="admin-panel admin-catalog-empty"><img src="{{ asset('images/logo-ultrapop-red.png') }}" alt="ULTRAPOP"><h2>Le catalogue est vide</h2><p>Importez votre PDF pour créer automatiquement les premières pages.</p></div>
      {% endfor %}
    </div>
    <template data-catalog-admin-target="emptyState"><div class="admin-panel admin-catalog-empty"><img src="{{ asset('images/logo-ultrapop-red.png') }}" alt="ULTRAPOP"><h2>Le catalogue est vide</h2><p>Importez votre PDF pour créer automatiquement les premières pages.</p></div></template>
  </section>
</div>
{% endblock %}
