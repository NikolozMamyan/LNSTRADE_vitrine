<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#11110f">
  <title>{% block title %}Administration{% endblock %} — LNS Trade</title>
  <link rel="icon" href="{{ asset('favicon.ico') }}" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
  {{ importmap('admin') }}
</head>
<body class="admin-body">
  <div class="admin-app">
    <aside class="admin-sidebar" id="admin-sidebar">
      <div class="admin-sidebar-head">
        <a class="admin-brand" href="{{ path('app_admin_dashboard') }}" aria-label="Accueil du back-office">
          <img src="{{ asset('images/logo-lns-white.png') }}" alt="LNS Trade">
          <span>Back-office</span>
        </a>
        <button class="admin-sidebar-close" type="button" data-admin-nav-close aria-label="Fermer le menu">
          <span></span><span></span>
        </button>
      </div>

      <nav class="admin-nav" aria-label="Navigation principale">
        <p class="admin-nav-label">Pilotage</p>
        <a class="admin-nav-link{{ app.current_route == 'app_admin_dashboard' ? ' is-active' : '' }}" href="{{ path('app_admin_dashboard') }}"{% if app.current_route == 'app_admin_dashboard' %} aria-current="page"{% endif %}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13h7V3H3v10Zm0 8h7v-5H3v5Zm11 0h7V11h-7v10Zm0-18v5h7V3h-7Z"/></svg>
          <span>Vue d’ensemble</span>
        </a>
        <a class="admin-nav-link" href="#recent-activity">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5l3 2m6-3a9 9 0 1 1-3-6.7M21 4v5h-5"/></svg>
          <span>Activité récente</span>
        </a>

        <a class="admin-nav-link{{ app.current_route starts with 'admin_catalog' ? ' is-active' : '' }}" href="{{ path('admin_catalog') }}"{% if app.current_route starts with 'admin_catalog' %} aria-current="page"{% endif %}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5v-17Zm0 0v17M8 6h8M8 10h8"/></svg>
          <span>Catalogue</span>
        </a>

        <p class="admin-nav-label admin-nav-label-secondary">Site</p>
        <a class="admin-nav-link" href="{{ path('app_home.fr') }}" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7m0-7-9 9M10 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/></svg>
          <span>Voir le site</span>
          <span class="admin-nav-external">↗</span>
        </a>
      </nav>

      <div class="admin-sidebar-footer">
        <div class="admin-user-card">
          <span class="admin-user-avatar">{{ app.user.userIdentifier|first|upper }}</span>
          <span class="admin-user-copy">
            <strong>Administrateur</strong>
            <small>{{ app.user.userIdentifier }}</small>
          </span>
        </div>
        <form method="post" action="{{ path('app_admin_logout') }}">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
          <button class="admin-logout" type="submit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4m7-4 4-4-4-4m4 4H9"/></svg>
            Se déconnecter
          </button>
        </form>
      </div>
    </aside>
    <button class="admin-sidebar-overlay" type="button" data-admin-nav-close aria-label="Fermer le menu"></button>

    <div class="admin-workspace">
      <header class="admin-topbar">
        <button class="admin-menu-toggle" type="button" data-admin-nav-open aria-controls="admin-sidebar" aria-expanded="false">
          <span></span><span></span><span></span>
          <span class="sr-only">Ouvrir le menu</span>
        </button>
        <div class="admin-topbar-title">
          <span>LNS Trade</span>
          <strong>{% block page_name %}Administration{% endblock %}</strong>
        </div>
        <div class="admin-topbar-status"><i></i> Système opérationnel</div>
      </header>

      <main class="admin-main">
        {% for type in ['success', 'error'] %}
          {% for message in app.flashes(type) %}
            <div class="admin-flash admin-flash-{{ type }}" role="status">{{ message }}</div>
          {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
      </main>
    </div>
  </div>
</body>
</html>
