{% extends 'admin/base.html.twig' %}
{% block title %}Personnaliser · {{ catalog.title }}{% endblock %}
{% block page_name %}Personnaliser le catalogue{% endblock %}
{% block body %}
{% set editorPages = [] %}
{% for page in catalogPages %}{% set editorPages = editorPages|merge([{id: page.id, title: page.title, image: page.imagePath ? asset(page.imagePath) : null, pdf: page.pdfPath ? asset(page.pdfPath) : null, pdfPage: page.pdfPage, elements: elementsByPage[page.id], saveUrl: path('admin_external_catalog_elements', {catalogId: catalog.id, pageId: page.id})}]) %}{% endfor %}
<div class="catalog-editor" data-controller="catalog-editor" data-catalog-editor-pages-value="{{ editorPages|json_encode|e('html_attr') }}" data-catalog-editor-worker-url-value="{{ asset('vendor/pdfjs-dist/build/pdf.worker.min.mjs.js') }}" data-catalog-editor-token-value="{{ csrf_token('catalog_elements_' ~ catalog.id) }}" data-catalog-editor-return-url-value="{{ path('admin_external_catalog_index') }}" data-turbo="false">
  <header class="catalog-editor-header"><div><a href="{{ path('admin_external_catalog_index') }}">← Vos catalogues</a><h1>{{ catalog.title }}</h1></div><span role="status" data-catalog-editor-target="status">Sélectionnez une page, puis ajoutez vos éléments.</span><button class="admin-button admin-button-primary" type="button" data-action="catalog-editor#save" data-catalog-editor-target="save">Enregistrer et terminer ✓</button></header>
  <div class="catalog-editor-layout">
    <aside class="catalog-editor-tools"><h2>Ajouter un élément</h2><button type="button" data-kind="link" data-action="catalog-editor#add">↗ <span>Lien</span></button><button type="button" data-kind="video" data-action="catalog-editor#add">▷ <span>Vidéo</span></button><p>Placez vos zones sur la page. Glissez-les pour les déplacer et utilisez leur coin pour les redimensionner.</p><a href="{{ path('admin_external_catalog', {catalogId: catalog.id}) }}">Gérer les pages / PDF ↗</a></aside>
    <div class="catalog-editor-workspace"><nav class="catalog-editor-thumbnails" aria-label="Pages du catalogue">{% for page in catalogPages %}<button type="button" data-action="catalog-editor#selectPage" data-index="{{ loop.index0 }}" data-catalog-editor-target="thumbnail" aria-label="Page {{ loop.index }}"><span>{% if page.imagePath %}<img src="{{ asset(page.imagePath) }}" alt="" loading="lazy">{% else %}<img data-pdf-source="{{ asset(page.pdfPath) }}" data-pdf-page="{{ page.pdfPage }}" alt="" hidden><b>PDF</b>{% endif %}</span><small>{{ loop.index }}</small></button>{% endfor %}</nav><div class="catalog-editor-canvas"><div class="catalog-editor-sheet" data-catalog-editor-target="sheet"><img data-catalog-editor-target="image" alt="Page en cours de personnalisation"><div class="catalog-editor-elements" data-catalog-editor-target="elements"></div></div></div></div>
    <aside class="catalog-editor-properties"><h2>Propriétés</h2><p data-catalog-editor-target="empty">Sélectionnez un lien ou une vidéo pour modifier sa destination et sa position.</p><div data-catalog-editor-target="properties" hidden><label>Libellé<input type="text" maxlength="160" data-field="label" data-action="input->catalog-editor#property" data-catalog-editor-target="label"></label><label>Adresse du lien / vidéo<input type="text" data-field="url" data-action="input->catalog-editor#property" data-catalog-editor-target="url"></label><div class="catalog-editor-geometry">{% for field, label in {x: 'Gauche %', y: 'Haut %', width: 'Largeur %', height: 'Hauteur %'} %}<label>{{ label }}<input type="number" min="0" max="100" step="0.1" data-field="{{ field }}" data-action="change->catalog-editor#property" data-catalog-editor-target="{{ field }}"></label>{% endfor %}</div><button class="admin-button admin-button-light" type="button" data-action="catalog-editor#remove">Supprimer cet élément</button></div></aside>
  </div>
  <dialog class="admin-external-dialog" data-catalog-editor-target="dialog" aria-labelledby="element-dialog-title"><form data-action="submit->catalog-editor#confirm"><button class="admin-external-dialog-close" type="button" data-action="catalog-editor#closeDialog" aria-label="Fermer">×</button><h2 id="element-dialog-title" data-catalog-editor-target="dialogTitle">Ajouter un lien</h2><p data-catalog-editor-target="dialogHint"></p><label class="admin-catalog-field"><span>Adresse</span><input type="text" name="url" required maxlength="2048" placeholder="https://…" autofocus></label><label class="admin-catalog-field"><span>Libellé <small>facultatif</small></span><input type="text" name="label" maxlength="160"></label><button class="admin-button admin-button-primary" type="submit">Ajouter à la page</button></form></dialog>
</div>
{% endblock %}
