{% extends 'admin/base.html.twig' %}
{% macro icon(kind) %}<svg viewBox="0 0 24 24" aria-hidden="true">{% if kind == 'customize' %}<path d="M4 7h16M4 17h16M8 3v8m8 2v8"/>{% elseif kind == 'share' %}<path d="M14 3v5C7 8 4 12 3 18c3-4 6-5 11-5v5l7-8-7-7Z"/>{% else %}<circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/>{% endif %}</svg>{% endmacro %}
{% block title %}Catalogues externes{% endblock %}
{% block page_name %}Catalogues externes{% endblock %}
{% block body %}
<div class="admin-catalog-library" data-controller="catalog-shares" data-catalog-shares-worker-url-value="{{ asset('vendor/pdfjs-dist/build/pdf.worker.min.mjs.js') }}" data-action="click@window->catalog-shares#outside" data-turbo="false">
  <header class="admin-library-heading"><div><h1>Vos catalogues <span>{{ catalogues|length }}</span></h1><p>Importez, personnalisez et partagez vos documents.</p></div><div><input class="admin-library-search" type="search" placeholder="Rechercher un catalogue…" aria-label="Rechercher un catalogue" data-action="input->catalog-shares#filter"><button class="admin-button admin-button-primary" type="button" data-action="catalog-shares#openDialog">Nouveau catalogue ＋</button></div></header>
  <div class="admin-flash admin-catalog-feedback" role="status" data-catalog-shares-target="feedback" hidden></div>
  <section class="admin-panel admin-library-table" aria-label="Vos catalogues">
    <div class="admin-library-table-head"><span>Catalogue</span><span>Dernière modification</span><span class="sr-only">Actions</span></div>
    {% for row in catalogues %}
      {% set catalog = row[0] %}
      <article class="admin-library-row" data-library-row data-title="{{ catalog.title }}">
        <div class="admin-library-document"><a class="admin-library-thumbnail" href="{{ path('admin_external_catalog', {catalogId: catalog.id}) }}" tabindex="-1" aria-hidden="true">{% if row.coverImage %}<img src="{{ asset(row.coverImage) }}" alt="" loading="lazy">{% elseif row.coverPdf %}<img data-catalog-shares-target="cover" data-pdf-source="{{ asset(row.coverPdf) }}" data-pdf-page="{{ row.coverPage|default(1) }}" alt="" hidden><span>PDF</span>{% else %}<span>PDF</span>{% endif %}</a><div><h2><a href="{{ path('admin_external_catalog', {catalogId: catalog.id}) }}">{{ catalog.title }}</a></h2><p>{{ row.pageCount }} page{{ row.pageCount != 1 ? 's' : '' }} <span>·</span> <span data-library-state>{{ catalog.enabled ? 'Actif' : 'Désactivé' }}</span>{% if row.pageCount == 0 %} · <a href="{{ path('admin_external_catalog', {catalogId: catalog.id}) }}">Ajouter un PDF</a>{% endif %}</p></div></div>
        <time datetime="{{ catalog.updatedAt|date('c') }}">{{ catalog.updatedAt|date('d/m/Y') }}</time>
        <div class="admin-library-actions">
          <a class="admin-library-action" href="{{ path('admin_external_catalog_customize', {catalogId: catalog.id}) }}">{{ _self.icon('customize') }}<span>Personnaliser</span></a>
          <button class="admin-library-action" type="button" data-action="catalog-shares#share" data-url="{{ path('admin_external_catalog_share_create', {catalogId: catalog.id}) }}" data-token="{{ csrf_token('catalog_share_' ~ catalog.id) }}" data-title="{{ catalog.title }}" data-pages="{{ row.pageCount }}">{{ _self.icon('share') }}<span>Partager</span></button>
          <label class="admin-library-switch"><input type="checkbox" aria-label="Activer {{ catalog.title }}" data-action="change->catalog-shares#toggle" data-url="{{ path('admin_external_catalog_toggle', {catalogId: catalog.id}) }}" data-token="{{ csrf_token('external_catalog_toggle_' ~ catalog.id) }}"{{ catalog.enabled ? ' checked' : '' }}><i></i><span>Actif</span></label>
          <details class="admin-library-more"><summary aria-label="Plus d’actions pour {{ catalog.title }}">{{ _self.icon('more') }}<span>Plus</span></summary><div><button type="button" data-action="catalog-shares#rename" data-title="{{ catalog.title }}" data-url="{{ path('admin_external_catalog_rename', {catalogId: catalog.id}) }}" data-token="{{ csrf_token('external_catalog_rename_' ~ catalog.id) }}">Renommer</button><a href="{{ path('admin_external_catalog', {catalogId: catalog.id}) }}">Gérer les pages / PDF</a><a href="{{ path('admin_external_catalog_preview', {catalogId: catalog.id}) }}" target="_blank" rel="noopener">Ouvrir le catalogue ↗</a><form action="{{ path('admin_external_catalog_delete', {catalogId: catalog.id}) }}" method="post" data-confirm="Supprimer ce catalogue, ses pages et ses liens de partage ?"><input type="hidden" name="_token" value="{{ csrf_token('external_catalog_delete_' ~ catalog.id) }}"><button class="is-danger" type="submit">Supprimer</button></form></div></details>
        </div>
      </article>
    {% else %}<div class="admin-library-empty"><h2>Ajoutez votre premier catalogue</h2><p>Créez un catalogue, puis importez votre PDF pour commencer.</p><button class="admin-button admin-button-primary" type="button" data-action="catalog-shares#openDialog">Créer un catalogue ＋</button></div>{% endfor %}
  </section>
  <dialog class="admin-external-dialog" data-catalog-shares-target="dialog" aria-labelledby="new-catalog-title" data-action="click->catalog-shares#backdrop"><form action="{{ path('admin_external_catalog_new') }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('external_catalog_new') }}"><button class="admin-external-dialog-close" type="button" data-action="catalog-shares#closeDialog" aria-label="Fermer">×</button><h2 id="new-catalog-title">Nouveau catalogue</h2><label class="admin-catalog-field"><span>Nom du catalogue</span><input type="text" name="title" maxlength="180" required placeholder="Ex. Catalogue clients" autofocus></label><small>Ajoutez ensuite vos documents et partagez votre catalogue avec vos clients.</small><button class="admin-button admin-button-primary" type="submit">Créer et ajouter mes documents ↗</button></form></dialog>
  <dialog class="admin-external-dialog" data-catalog-shares-target="renameDialog" aria-labelledby="rename-title"><form method="post"><input type="hidden" name="_token"><button class="admin-external-dialog-close" type="button" data-action="catalog-shares#closeModal" aria-label="Fermer">×</button><h2 id="rename-title">Renommer le catalogue</h2><label class="admin-catalog-field"><span>Nouveau nom</span><input type="text" name="title" maxlength="180" required></label><button class="admin-button admin-button-primary" type="submit">Enregistrer</button></form></dialog>
  <dialog class="admin-external-dialog admin-library-share-dialog" data-catalog-shares-target="shareDialog" aria-labelledby="share-title"><div class="admin-library-modal-content" data-share-row><button class="admin-external-dialog-close" type="button" data-action="catalog-shares#closeModal" aria-label="Fermer">×</button><h2 id="share-title">Partager le catalogue</h2><p data-catalog-shares-target="shareTitle"></p><p class="admin-library-share-status" data-catalog-shares-target="shareStatus" role="status">Préparation du lien…</p><label class="admin-catalog-field"><span>Lien de partage</span><input class="admin-share-url" type="url" readonly data-catalog-shares-target="shareUrl" aria-label="Lien de partage"></label><button class="admin-button admin-button-primary" type="button" data-action="catalog-shares#copy" data-catalog-shares-target="shareCopy" disabled>Copier le lien</button><label class="admin-library-share-page"><input type="checkbox" data-catalog-shares-target="sharePageEnabled" data-action="change->catalog-shares#pageLink"> Ouvrir à la page <input type="number" min="1" value="1" data-catalog-shares-target="sharePage" data-action="input->catalog-shares#pageLink" aria-label="Page à partager"></label><small>Envoyez ce lien à vos clients. Ils peuvent consulter le catalogue sans compte.</small></div></dialog>
</div>
{% endblock %}
