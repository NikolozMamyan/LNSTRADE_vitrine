{% extends 'admin/base.html.twig' %}

{% block title %}Visiteurs{% endblock %}
{% block page_name %}Visiteurs{% endblock %}

{% block body %}
  <section class="dashboard-hero">
    <div>
      <p class="admin-eyebrow"><span></span> Audience du site</p>
      <h1>Visiteurs</h1>
      <p>Suivez les sessions, les adresses IP et les pages consultées.</p>
    </div>
    <span class="visitor-live-status" data-visitor-status role="status"><i></i> Actualisation toutes les 10 secondes</span>
  </section>

  <form class="visitor-filters" method="get" action="{{ path('app_admin_visitors') }}">
    <label>Période
      <select name="days">
        {% for value, label in {7: '7 derniers jours', 30: '30 derniers jours', 90: '90 derniers jours', 0: 'Tout l’historique'} %}
          <option value="{{ value }}"{{ days == value ? ' selected' : '' }}>{{ label }}</option>
        {% endfor %}
      </select>
    </label>
    <label>Adresse IP
      <input name="ip" value="{{ ip }}" placeholder="Toutes les adresses IP" maxlength="45" autocomplete="off">
    </label>
    <button class="admin-button admin-button-primary" type="submit">Filtrer</button>
    {% if ip %}<a class="admin-button admin-button-light" href="{{ path('app_admin_visitors', {days: days}) }}">Effacer l’IP</a>{% endif %}
  </form>

  <div data-visitor-refresh-url="{{ path('app_admin_visitors', {days: days, ip: ip, page: page}) }}">
    {% include 'admin/visitors/_overview.html.twig' %}
  </div>
{% endblock %}
